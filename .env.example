# Copy this file to .env and fill in what you need. Restart `npm start` after changes.
# Never commit .env — it is git-ignored.

# REQUIRED for AI editing + marketing (Claude). Create one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# Optional: spoken-word subtitles via OpenAI Whisper speech-to-text.
# Claude reviews video frames but can't listen to audio, so this is separate.
# OPENAI_API_KEY=

# Optional: FFmpeg location if it is not on your PATH.
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Optional server settings.
# PORT=3000
# HOST=127.0.0.1          # use 0.0.0.0 to open it from your phone on the same Wi-Fi
# DATA_DIR=data           # where uploads, renders and projects are stored
# MAX_UPLOAD_MB=2048
# AI_MAX_FRAMES=40        # frames sampled per generation for Claude to review
# CLAUDE_FALLBACKS=on     # server-side refusal fallback; set to off to disable
# CUTLINE_HWACCEL=off     # Macs use hardware video decoding by default; set off to disable
