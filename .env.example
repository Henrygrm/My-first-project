# Copy to .env for local testing (never commit it), and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Anything left blank runs in demo mode.

# Claude (AI coach) – https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase (accounts) – Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # secret: server only

# Stripe (payments) – Developers → API keys / Webhooks
STRIPE_SECRET_KEY=           # sk_test_... while testing, sk_live_... when you go live
STRIPE_WEBHOOK_SECRET=       # whsec_...

# Optional: your site's address, used for Stripe return links
SITE_URL=
